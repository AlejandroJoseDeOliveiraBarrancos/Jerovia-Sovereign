# Copy to .env and adjust. Never commit the result: .env is gitignored.

# --- runtime ---------------------------------------------------------------
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=true
RAG_PORT=8000

# --- secrets (leave empty to run fully offline with the fakes) -------------
RAG_OPENAI_API_KEY=
RAG_LLM_GATEWAY_API_KEY=

# --- postgres --------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_PASSWORD=rag_engine_dev_password
RAG_POSTGRES_DB=rag_engine
RAG_POSTGRES_USER=rag_engine

# --- vector store slot (decided in E6) -------------------------------------
RAG_VECTOR_STORE_PROVIDER=fake
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- pinned component versions --------------------------------------------
# Production refuses to start while parser/chunker/prompt are "unpinned".
RAG_PARSER_VERSION=unpinned
RAG_CHUNKER_VERSION=v1
RAG_PROMPT_VERSION=v1
RAG_LLM_MODEL_ID=gpt-4.1-mini-2025-04-14
RAG_EMBEDDER_MODEL_ID=text-embedding-3-small
RAG_EMBEDDER_DIMENSION=1536
